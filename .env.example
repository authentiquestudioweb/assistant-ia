# --- Moteur : avec GROQ_API_KEY, Léa utilise Groq (cloud, rapide). MOTEUR=local pour Ollama. ---
GROQ_API_KEY=
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GROQ_LLM_FALLBACK=openai/gpt-oss-20b,qwen/qwen3.8-27b
# GROQ_STT_MODEL=whisper-large-v3
# Code d'accès à la page publique (obligatoire sur un Space ; 8 chiffres ou plus)
# LEA_CODE=

# --- LLM (toute API compatible OpenAI ; défaut : Ollama local) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.3

# --- Cabinet ---
CABINET_NAME=Cabinet dentaire du Parc
TIMEZONE=Europe/Paris
OPENING_HOUR=8
CLOSING_HOUR=17
SLOT_MINUTES=30
# 0=lundi ... 6=dimanche
OPEN_DAYS=0,1,2,3,4

# --- Agenda : mock (fichier JSON local) ou google ---
CALENDAR_BACKEND=mock
MOCK_CALENDAR_PATH=data/calendar.json
URGENCES_LOG_PATH=data/urgences.jsonl

# --- Google Calendar (si CALENDAR_BACKEND=google) ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary
